{
  "manifest_version": 3,
  "name": "Salsey",
  "version": "0.1.0",
  "description": "Listens in on a sales call and surfaces objection handling, talking points, and answers in real time.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://salsey.vercel.app/*", "https://gnxhkbhlypozaisvezbg.supabase.co/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Salsey",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
